{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ecommerce-api",
    "Audience": "ecommerce-clients",
    "ExpiryMinutes": 60
  },
  "Security": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  }
}
