{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MainDb": "Server=YOUR_SERVER;Database=MainDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ecommerce-api",
    "Audience": "ecommerce-clients",
    "ExpiryMinutes": 60,
    "Key": "YOUR_KEY"
  },
  "Security": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "Seed": {
    "AdminEmail": "admin@ecommerce.com",
    "AdminPassword": "Admin@12345"
  }
}
